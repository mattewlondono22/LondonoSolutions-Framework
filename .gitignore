# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# builds
.next/
out/
dist/
build/
coverage/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment / secrets
.env
.env.*
!.env.example
.vercel
.netlify

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts

# local exports / release bundles / patch files
release-export/
exports/
tmp/
temp/
*.zip
*.patch
*.diff
*.bak
*.tmp
*.temp
binary-base64.txt
changed-files.txt
londonosolutions-site-release.patch
londonosolutions-site-release.zip
londonosolutions-release.zip

# screenshots / recordings
screenshots/
recordings/
*.mp4
*.mov

# local databases / tabular data
*.csv
*.tsv
*.xlsx
*.xls
*.sqlite
*.db

# keys / certs
*.pem
*.key
*.crt
*.p12

# internal / private / client content
private/
internal/
clients/
client-data/
notes/
journal/
drafts/
archive/

# images default ignore
*.png
*.jpg
*.jpeg
*.webp

# allow intentional public assets only
!public/
!public/**
!src/**/*.png
!src/**/*.jpg
!src/**/*.jpeg
!src/**/*.webp
!src/**/*.svg

# re-exclude non-framework images in src/docs
src/docs/**/*.png
src/docs/**/*.jpg
src/docs/**/*.jpeg
src/docs/**/*.webp

# re-exclude internal docs in src/docs
src/docs/sitrep.md
src/docs/INVICTUS*.md
